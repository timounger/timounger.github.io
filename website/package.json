{
  "name": "bonprinter-website",
  "version": "0.1.0",
  "private": true,
  "description": "BonPrinter - Thermal printer tool",
  "author": "Timo Unger",
  "main": "electron/main.js",
  "scripts": {
    "app:start": "electron .",
    "app:icon": "node scripts/generate-app-icon.mjs",
    "app:bridge": "python -m PyInstaller --onefile --collect-all smartcard --distpath electron/bin --workpath build/pyi --specpath build/pyi tools/nfc-bridge/nfc_bridge.py",
    "app:printer-bridge": "python -m PyInstaller --onefile --collect-all escpos --distpath electron/bin --workpath build/pyi --specpath build/pyi tools/printer-bridge/printer_bridge.py",
    "app:dist": "npm run app:bridge && npm run app:printer-bridge && next build && electron-builder --win",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "spell": "cspell \"**\" --no-progress --no-must-find-files",
    "knip": "knip",
    "check": "npm run lint && npm run format:check && npm run spell && npm run typecheck && npm run test",
    "deps:check": "npm outdated",
    "deps:update": "npm update",
    "deps:upgrade": "npx --yes npm-check-updates -u && npm install",
    "docs": "typedoc && node scripts/open-docs.mjs",
    "thumbs": "node scripts/generate-thumbs.mjs",
    "prepare": "cd .. && husky website/.husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,mjs,cjs,json,css,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "lucide-react": "^0.469.0",
    "next": "^15.1.3",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-day-picker": "^9.4.4",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cspell/dict-de-de": "^4.1.2",
    "@eslint/eslintrc": "^3.3.5",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.20",
    "cspell": "^8.19.4",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "eslint-plugin-jsdoc": "^63.0.2",
    "husky": "^9.1.7",
    "knip": "^6.16.1",
    "lint-staged": "^17.0.7",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.4.49",
    "prettier": "^3.4.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "typedoc": "^0.28.19",
    "typedoc-material-theme": "^1.4.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.8"
  },
  "browserslist": [
    "Chrome >= 93",
    "Edge >= 93",
    "Firefox >= 92",
    "Safari >= 15.4",
    "iOS >= 15.4",
    "not dead"
  ]
}
