{
  "name": "bonprinter-website",
  "version": "0.1.0",
  "private": true,
  "description": "BonPrinter - Thermal printer tool",
  "author": "Timo Unger",
  "main": "electron/main.js",
  "scripts": {
    "app:start": "electron .",
    "app:icon": "node scripts/generate-app-icon.mjs",
    "app:bridge": "python -m PyInstaller --onefile --collect-all smartcard --distpath electron/bin --workpath build/pyi --specpath build/pyi tools/nfc-bridge/nfc_bridge.py",
    "app:printer-bridge": "python -m PyInstaller --onefile --collect-all escpos --distpath electron/bin --workpath build/pyi --specpath build/pyi tools/printer-bridge/printer_bridge.py",
    "app:excel-report": "node scripts/build-excel-report.mjs",
    "app:dist": "npm run app:bridge && npm run app:printer-bridge && npm run app:excel-report && next build && electron-builder --win",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "spell": "cspell \"**\" --no-progress --no-must-find-files",
    "knip": "knip",
    "check": "npm run lint && npm run format:check && npm run spell && npm run typecheck && npm run test",
    "deps:check": "npm outdated",
    "deps:update": "npm update",
    "deps:upgrade": "npx --yes npm-check-updates -u && npm install",
    "docs": "typedoc && node scripts/open-docs.mjs",
    "thumbs": "node scripts/generate-thumbs.mjs",
    "prepare": "cd .. && husky website/.husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,mjs,cjs,json,css,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "lucide-react": "^1.61.0",
    "next": "^16.4.2",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cspell/dict-de-de": "^4.1.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "cspell": "^10.4.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "eslint-plugin-jsdoc": "^65.4.1",
    "husky": "^9.1.7",
    "knip": "^6.42.1",
    "lint-staged": "^17.6.0",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.19",
    "typedoc": "^0.28.20",
    "typedoc-material-theme": "^1.4.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "browserslist": [
    "Chrome >= 93",
    "Edge >= 93",
    "Firefox >= 92",
    "Safari >= 15.4",
    "iOS >= 15.4",
    "not dead"
  ]
}
